  },
  "peerDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  }
}
